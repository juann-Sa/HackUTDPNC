# Where the Next.js server reaches SpacetimeDB (the browser never connects directly).
SPACETIMEDB_HOST=http://localhost:3000
SPACETIMEDB_DB=spacetime360
# Optional: reuse an identity token instead of minting a new one per server start.
# SPACETIMEDB_TOKEN=
# GROQ_API_KEY belongs in the SpacetimeDB module environment, not this frontend file.