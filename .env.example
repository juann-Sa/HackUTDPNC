# Copy to .env.local. `spacetime dev` also rewrites .env.local for you.
# Local development (spacetime start):
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=spacetime360
# Demo on Maincloud:
# VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
# VITE_SPACETIMEDB_DB_NAME=spacetime360

# Backend-only credentials for the Plaid Sandbox API and SpacetimeDB.
PLAID_CLIENT_ID=
PLAID_SECRET=
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DB_NAME=spacetime360
SPACETIMEDB_TOKEN=
BANK_CONNECT_API_KEY=
API_PORT=3001
